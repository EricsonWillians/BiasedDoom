{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
    "builtin-baseline": "0659bf17507c88f2da8cb196303a5b6fd862f817",
    "features":
    {
        "vcpkg-libvpx":
        {
            "description": "Use libvpx provided by vcpkg on Windows",
            "dependencies": [
                {
                    "name": "libvpx",
                    "default-features": false,
                    "platform": "(!windows & static) | (windows & static & (staticcrt | mingw))"
                }
            ]
        },
        "vcpkg-openal-soft":
        {
            "description": "Use openal-soft provided by vcpkg.",
            "dependencies": [
                {
                    "name": "openal-soft",
                    "default-features": false,
                    "platform": "(!windows & static) | (windows & static & (staticcrt | mingw))"
                }
            ]
        },
        "vcpkg-libsndfile":
        {
            "description": "Use libsndfile with compressed audio codecs provided by vcpkg.",
            "dependencies": [
                {
                    "name": "libsndfile",
                    "default-features": false,
                    "features": [ "mpeg", "external-libs" ],
                    "platform": "(!windows & static) | (windows & static & (staticcrt | mingw))"
                }
            ]
        },
        "vcpkg-python":
        {
            "description": "Embed CPython for trusted Python-scripted mods on native Windows and macOS builds.",
            "dependencies": [
                {
                    "name": "python3",
                    "default-features": false,
                    "platform": "(windows & static & staticcrt & !mingw) | osx"
                }
            ]
        },
        "gltf-support":
        {
            "description": "Enable glTF 2.0 model support for modern 3D assets",
            "dependencies": [
                {
                    "name": "fastgltf",
                    "default-features": false
                }
            ]
        },
        "online":
        {
            "description": "Enable authenticated online sessions, encrypted relays, and content synchronization.",
            "dependencies": [
                "curl",
                "libsodium"
            ]
        }
    },
    "overrides": [
        {
            "name": "libsodium",
            "version": "1.0.22"
        },
        {
            "name": "libsndfile",
            "version-semver": "1.2.2",
            "port-version": 2
        },
        {
            "name": "mpg123",
            "version": "1.33.4"
        },
        {
            "name": "openal-soft",
            "version": "1.25.1"
        },
        {
            "name": "python3",
            "version": "3.12.13",
            "port-version": 1
        },
        {
            "name": "vcpkg-get-python",
            "version-date": "2025-02-09"
        },
        {
            "name": "vcpkg-cmake-get-vars",
            "version-date": "2025-05-29"
        },
        {
            "name": "vcpkg-make",
            "version-date": "2026-01-01"
        },
        {
            "name": "yasm",
            "version": "1.3.0",
            "port-version": 7
        }
    ],
    "dependencies": []
}
