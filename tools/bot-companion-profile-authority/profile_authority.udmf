namespace = "zdoom";

// One quiet room with several ordinary cooperative starts. The test uses the
// public addcompanion path and observes only roster state; it does not need
// combat or navigation geometry to exercise profile/legacy reconciliation.
thing { x = -192.0; y = -192.0; angle = 0; type = 1; skill1 = true; skill2 = true; skill3 = true; skill4 = true; skill5 = true; single = true; coop = true; dm = true; }
thing { x = -64.0; y = -192.0; angle = 0; type = 2; skill1 = true; skill2 = true; skill3 = true; skill4 = true; skill5 = true; single = true; coop = true; dm = true; }
thing { x = 64.0; y = -192.0; angle = 0; type = 3; skill1 = true; skill2 = true; skill3 = true; skill4 = true; skill5 = true; single = true; coop = true; dm = true; }
thing { x = 192.0; y = -192.0; angle = 0; type = 4; skill1 = true; skill2 = true; skill3 = true; skill4 = true; skill5 = true; single = true; coop = true; dm = true; }

vertex { x = -256.0; y = -256.0; }
vertex { x = 256.0; y = -256.0; }
vertex { x = 256.0; y = 256.0; }
vertex { x = -256.0; y = 256.0; }

sector { heightfloor = 0; heightceiling = 128; lightlevel = 192; texturefloor = "FLOOR4_8"; textureceiling = "CEIL3_5"; }

sidedef { sector = 0; texturemiddle = "STARTAN3"; }

linedef { v1 = 0; v2 = 1; sidefront = 0; }
linedef { v1 = 1; v2 = 2; sidefront = 0; }
linedef { v1 = 2; v2 = 3; sidefront = 0; }
linedef { v1 = 3; v2 = 0; sidefront = 0; }
