namespace = "zdoom";

// A one-player-wide 64-unit corridor. Player 2 is the preferred companion
// spawn, so the fixture can freeze it in the only route to the terminal wall.
thing { x = 0.0; y = 0.0; angle = 0; type = 1; skill1 = true; skill2 = true; skill3 = true; skill4 = true; skill5 = true; single = true; coop = true; dm = true; }
thing { x = 144.0; y = 0.0; angle = 0; type = 2; skill1 = true; skill2 = true; skill3 = true; skill4 = true; skill5 = true; single = true; coop = true; dm = true; }

vertex { x = -64.0; y = -32.0; }
vertex { x = 384.0; y = -32.0; }
vertex { x = 384.0; y = 32.0; }
vertex { x = -64.0; y = 32.0; }

sector
{
    heightfloor = 0;
    heightceiling = 128;
    lightlevel = 192;
    texturefloor = "FLOOR4_8";
    textureceiling = "CEIL3_5";
}

sidedef { sector = 0; texturemiddle = "DOOR3"; }

linedef { v1 = 0; v2 = 3; sidefront = 0; }
linedef { v1 = 3; v2 = 2; sidefront = 0; }
linedef { v1 = 2; v2 = 1; sidefront = 0; }
linedef { v1 = 1; v2 = 0; sidefront = 0; }
